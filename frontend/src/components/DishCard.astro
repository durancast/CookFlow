---
// src/components/DishCard.astro
const { product } = Astro.props;

// 1. Configuración de rutas
const backendUrl = "http://127.0.0.1:8000"; 
const imageUrl = product.image 
  ? `${backendUrl}/storage/products/${product.image}`
  : 'https://placehold.co/400x400/18181b/6366f1?text=CookFlow';

// 2. Formateo de datos
const priceValue = parseFloat(product.price);
---

<article class="bg-tpv-surface border border-tpv-border rounded-xl overflow-hidden hover:border-tpv-accent/50 transition-all group flex flex-col h-full">
  
  <div class="aspect-square overflow-hidden bg-zinc-900 relative">
    <img 
      src={imageUrl} 
      alt={product.name} 
      class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
      loading="lazy"
    />
    <span class="absolute top-2 left-2 bg-black/60 backdrop-blur-md text-[10px] text-white px-2 py-1 rounded-md uppercase font-bold tracking-tighter">
      {product.category.name}
    </span>
  </div>

  <div class="p-4 flex flex-col flex-1 justify-between gap-2">
    <div>
      <h2 class="font-sans text-lg font-semibold text-tpv-text line-clamp-2 leading-tight">
        {product.name}
      </h2>
      <p class="text-xs text-tpv-text-muted mt-1 line-clamp-2 italic">
        {product.description}
      </p>
    </div>
    
    <div class="mt-2 flex items-center justify-between">
      <div class="flex flex-col">
        <span class="text-[10px] text-tpv-text-muted uppercase font-medium">Precio</span>
        <span class="font-mono text-xl font-bold text-tpv-accent">
          {priceValue.toFixed(2)}€
        </span>
      </div>
      
      <button 
        class="add-to-cart-btn bg-tpv-accent hover:bg-tpv-accent-hover text-white p-3 rounded-xl transition-all active:scale-90 shadow-lg shadow-indigo-500/20"
        data-id={product.id}
        data-name={product.name}
        data-price={product.price}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
      </button>
    </div>
  </div>
</article>