---
import type { Product } from '../types/api';

interface Props {
  product: Product;
}

const { product } = Astro.props;

const backendUrl = import.meta.env.PUBLIC_BACKEND_URL || 'http://127.0.0.1:8000';

const imageUrl = product.image 
  ? `${backendUrl}/storage/products/${product.image}` 
  : 'https://placehold.co/600x400?text=Sin+Imagen';
---
<article class="dish-card flex flex-col bg-tpv-surface border border-tpv-border rounded-2xl overflow-hidden hover:border-tpv-accent transition-all duration-300 shadow-sm hover:shadow-tpv-accent/20 group" data-category={product.category.name}>  
  <div class="h-32 md:h-40 w-full overflow-hidden bg-tpv-bg relative">
    <img 
      src={imageUrl} 
      alt={product.name} 
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      loading="lazy"
      onerror="this.src='https://placehold.co/600x400?text=Error+de+Imagen'"
    />
    <span class="absolute top-2 right-2 bg-tpv-surface/90 backdrop-blur text-xs px-2 py-1 rounded-full border border-tpv-border font-medium">
      {product.category.name}
    </span>
  </div>

  <div class="p-4 flex flex-col flex-1">
    <h3 class="font-bold text-lg leading-tight mb-1 truncate" title={product.name}>
      {product.name}
    </h3>
    
    <div class="mt-auto pt-3 flex items-center justify-between">
      <span class="font-mono text-lg font-bold">
        {parseFloat(product.price.toString()).toFixed(2)}€
      </span>
      
      <button 
        class="add-to-cart-btn bg-tpv-accent hover:bg-tpv-accent-hover text-white p-2 rounded-xl transition-colors active:scale-95 flex items-center justify-center"
        data-product={JSON.stringify(product)}
        aria-label={`Añadir ${product.name} al pedido`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
      </button>
    </div>
  </div>
</article>

<script>
  import { addToCart } from '../store/cartStore.js';

  function setupCartButtons() {
    const buttons = document.querySelectorAll('.add-to-cart-btn');
    
    buttons.forEach(btn => {
      if (btn.getAttribute('data-listener-attached') === 'true') return;
      
      btn.addEventListener('click', (e) => {
        const button = e.currentTarget;
        
        if (!(button instanceof HTMLButtonElement)) return;
        
        const productData = JSON.parse(button.dataset.product || '{}');
        addToCart(productData);
      });
      
      btn.setAttribute('data-listener-attached', 'true');
    });
  }

  setupCartButtons();
</script>
