---
// src/components/NavSidebar.astro
---
<nav class="w-24 bg-tpv-bg border-r border-tpv-border flex flex-col h-full items-center py-6 font-sans">

  <div class="shrink-0 mb-4">
    <div class="w-12 h-12 bg-tpv-accent rounded-2xl flex items-center justify-center text-white font-black text-xl shadow-lg shadow-tpv-accent/30">
      CF
    </div>
  </div>

  <div class="shrink-0 w-full px-2 mb-3">
    <a
      href="/cocina"
      class="flex flex-col items-center gap-1 py-3 px-2 rounded-2xl text-tpv-text-muted hover:bg-tpv-surface hover:text-tpv-accent border border-transparent hover:border-tpv-border transition-all group"
      title="Pantalla de Cocina"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8 21V7a4 4 0 0 1 8 0v14"/><path d="M4 21h16"/><path d="M12 3v4"/>
      </svg>
      <span class="text-[9px] font-black uppercase tracking-tighter">Cocina</span>
    </a>
  </div>

  <p class="shrink-0 text-[9px] font-black uppercase tracking-widest text-tpv-text-muted mb-3">Sala</p>

  <div id="nav-tables-list" class="flex-1 w-full px-2 flex flex-col gap-2 overflow-y-auto custom-scrollbar">
    <div class="w-full h-10 rounded-2xl bg-tpv-surface animate-pulse"></div>
    <div class="w-full h-10 rounded-2xl bg-tpv-surface animate-pulse opacity-70"></div>
    <div class="w-full h-10 rounded-2xl bg-tpv-surface animate-pulse opacity-40"></div>
  </div>

  <div class="shrink-0 mt-auto w-full px-2 flex flex-col gap-2 border-t border-tpv-border/30 pt-6">

    <button class="flex flex-col items-center gap-1 py-4 px-2 w-full rounded-2xl text-tpv-text-muted hover:bg-tpv-surface hover:text-tpv-text transition-all group">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 group-hover:rotate-45 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1Z"/>
      </svg>
      <span class="text-[10px] font-black uppercase tracking-tighter">Ajustes</span>
    </button>

    <button
      id="logout-btn"
      class="flex flex-col items-center justify-center py-4 px-2 text-red-400/60 hover:text-red-400 hover:bg-red-500/10 rounded-2xl transition-all group"
      title="Cerrar Sesión"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mb-1 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
      </svg>
      <span class="text-[10px] font-black uppercase tracking-tighter">Salir</span>
    </button>

  </div>
</nav>

<script>
  import { selectedTable } from '../store/cartStore.js';

  let cachedTables: any[] = [];

  function tableButtonHTML(table: any, activeId: number | null) {
    const isActive = table.id === activeId;
    let cls = 'border-tpv-border text-tpv-text-muted hover:border-tpv-accent hover:text-tpv-accent';
    let dotCls = 'bg-tpv-border';

    if (isActive) {
      cls = 'bg-tpv-accent/10 border-tpv-accent text-tpv-accent shadow-lg shadow-tpv-accent/10';
      dotCls = 'bg-tpv-accent';
    } else if (table.status === 'occupied') {
      cls = 'border-red-500/30 text-red-400 hover:border-red-500/60';
      dotCls = 'bg-red-500 animate-pulse';
    } else if (table.status === 'pending') {
      cls = 'border-yellow-500/40 text-yellow-500 hover:border-yellow-500/70';
      dotCls = 'bg-yellow-500 animate-pulse';
    }

    return `
      <button
        onclick="window.selectTable(${table.id}, ${table.number}, '${table.status}')"
        data-table-id="${table.id}"
        class="w-full flex flex-col items-center gap-1.5 py-3 rounded-2xl border-2 transition-all active:scale-90 ${cls}">
        <span class="font-mono font-black text-lg leading-none">${table.number}</span>
        <div class="w-2 h-2 rounded-full ${dotCls}"></div>
      </button>`;
  }

  function renderNavTables() {
    const container = document.getElementById('nav-tables-list');
    if (!container || cachedTables.length === 0) return;
    const active = selectedTable.get();
    container.innerHTML = cachedTables.map(t => tableButtonHTML(t, active?.id ?? null)).join('');
  }

  async function loadNavTables() {
    try {
      const res = await fetch('/api/tables', {
        headers: {
          'Authorization': `Bearer ${localStorage.getItem('auth_token')}`,
          'Accept': 'application/json'
        }
      });
      if (!res.ok) return;
      cachedTables = await res.json();
      renderNavTables();
    } catch (e) {}
  }

  // Re-render highlight when active table changes
  selectedTable.subscribe(() => renderNavTables());

  document.getElementById('logout-btn')?.addEventListener('click', () => {
    localStorage.removeItem('auth_token');
    localStorage.removeItem('user_role');
    localStorage.removeItem('user_name');
    window.location.href = '/';
  });

  document.addEventListener('DOMContentLoaded', () => {
    loadNavTables();
    setInterval(loadNavTables, 30000);
  });
</script>
