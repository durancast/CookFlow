---
---
<div class="flex flex-col h-full w-full overflow-hidden bg-tpv-surface">
  <div class="shrink-0 p-6 border-b border-tpv-border">
    <h2 class="text-xl font-bold text-tpv-text">Pedido Actual</h2>
    <p class="text-[10px] text-tpv-text-muted uppercase tracking-widest mt-1">Ticket #4502</p>
  </div>

  <div id="cart-items" class="flex-1 overflow-y-auto p-4 space-y-3 custom-scrollbar">
    <div id="empty-message" class="text-center py-10 text-tpv-text-muted text-sm italic">
      El ticket está vacío
    </div>
  </div>

  <div class="shrink-0 p-6 border-t border-dashed border-tpv-border bg-black/20">
    <div class="flex justify-between items-center mb-4">
      <span class="text-tpv-text-muted font-medium">Total pedido</span>
      <span id="cart-total" class="font-mono text-3xl font-bold text-tpv-accent">0.00€</span>
    </div>
    
    <button class="w-full bg-tpv-accent hover:bg-tpv-accent-hover text-white font-bold py-4 rounded-xl transition-all active:scale-[0.98] shadow-lg shadow-indigo-500/20">
      COBRAR
    </button>
  </div>
</div>