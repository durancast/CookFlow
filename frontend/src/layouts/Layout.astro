---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "CookFlow TPV" } = Astro.props;
---

<!doctype html>
<html lang="es" class="bg-tpv-bg text-tpv-text">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="font-sans antialiased h-screen w-full overflow-hidden m-0 p-0 selection:bg-tpv-accent/30">
    <slot />
  </body>
</html>