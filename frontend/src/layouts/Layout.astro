---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "CookFlow TPV" } = Astro.props;
---

<!doctype html>
<html lang="es" class="bg-tpv-bg text-tpv-text">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="font-sans antialiased h-screen w-full overflow-hidden m-0 p-0 selection:bg-tpv-accent/30">
    
    <div id="toast-container" class="fixed bottom-8 right-8 z-100 flex flex-col gap-3"></div>

    <slot />

    <script is:inline>
      window.showToast = (message, type = 'success') => {
        const container = document.getElementById('toast-container');
        if (!container) return;

        const toast = document.createElement('div');
        
        // Estilos corporativos según éxito o error
        const bgColor = type === 'success' ? 'bg-tpv-accent' : 'bg-red-500';
        const icon = type === 'success' ? '✅' : '❌';

        // Clases de Tailwind para la animación y el diseño
        toast.className = `${bgColor} text-white px-6 py-4 rounded-2xl shadow-2xl flex items-center gap-3 border border-white/10 font-bold transition-all duration-300 transform translate-y-4 opacity-0`;
        toast.innerHTML = `<span>${icon}</span> <span>${message}</span>`;
        
        container.appendChild(toast);

        // Animación de entrada
        setTimeout(() => {
          toast.classList.remove('translate-y-4', 'opacity-0');
        }, 10);

        // Auto-eliminar después de 3 segundos
        setTimeout(() => {
          toast.classList.add('opacity-0', 'translate-y-2');
          setTimeout(() => toast.remove(), 300);
        }, 3000);
      };
    </script>
  </body>
</html>