---
import Layout from '../layouts/Layout.astro';
import DishCard from '../components/DishCard.astro';
import NavSidebar from '../components/NavSidebar.astro';
import OrderSidebar from '../components/react/OrderSidebar.jsx'; 
import type { Product } from '../types/api'; 

const backendUrl = import.meta.env.PUBLIC_BACKEND_URL || 'http://127.0.0.1:8000';

// 1. Petición al backend
const res = await fetch(`${backendUrl}/api/products`);
const products: Product[] = await res.json();

// 2. Categorías únicas
const categories = ['Todos', ...new Set(products.map(p => p.category.name))];
---

<Layout title="TPV - CookFlow">
  <div class="flex h-screen overflow-hidden bg-tpv-bg relative font-sans">
    
    <aside class="hidden md:flex shrink-0 h-full border-r border-tpv-border bg-tpv-surface">
      <NavSidebar />
    </aside>

    <main class="flex-1 flex flex-col min-w-0 h-full overflow-hidden w-full relative">
      
      <header class="shrink-0 p-4 md:p-6 border-b border-tpv-border bg-tpv-surface/80 backdrop-blur-md">
        <div class="flex gap-3 overflow-x-auto pb-2 custom-scrollbar">
          {categories.map((cat) => (
            <button 
              class={`category-btn px-6 py-2.5 rounded-xl border transition-all whitespace-nowrap font-bold text-sm
                ${cat === 'Todos' 
                  ? 'bg-tpv-accent border-tpv-accent text-white shadow-lg shadow-tpv-accent/20' 
                  : 'bg-tpv-bg border-tpv-border text-tpv-text-muted hover:border-tpv-accent hover:text-tpv-accent'}`}
            >
              {cat}
            </button>
          ))}
        </div>
      </header>

      <section class="flex-1 overflow-y-auto p-4 md:p-6 custom-scrollbar relative bg-tpv-bg">
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 gap-4 pb-32 lg:pb-10">
          {products.map(p => <DishCard product={p} />)}
        </div>
      </section>

      <div class="absolute bottom-0 left-0 w-full p-6 bg-linear-to-t from-tpv-bg via-tpv-bg/95 to-transparent lg:hidden z-50">
        <button 
          id="mobile-cart-btn"
          class="w-full bg-tpv-accent hover:bg-tpv-accent-hover text-white font-black py-4 px-6 rounded-2xl shadow-2xl shadow-tpv-accent/40 flex justify-between items-center transition-all active:scale-95 border border-white/10"
        >
          <div class="flex items-center gap-3">
            <span id="mobile-cart-count" class="bg-white/20 text-white text-sm py-1.5 px-3 rounded-lg font-mono font-bold">
              0
            </span>
            <span class="tracking-widest uppercase text-sm">Ver Pedido</span>
          </div>
          
          <span id="mobile-cart-total" class="font-mono text-xl font-black">
            0.00€
          </span>
        </button>
      </div>
    </main>

    <aside class="hidden lg:flex shrink-0 w-80 xl:w-96 border-l border-tpv-border h-full bg-tpv-bg z-40">
      <OrderSidebar client:only="react" />
    </aside>

  </div>
</Layout>

<script>
  import { cartItems } from '../store/cartStore.js';

  document.addEventListener('DOMContentLoaded', () => {
    const countEl = document.getElementById('mobile-cart-count');
    const totalEl = document.getElementById('mobile-cart-total');

    // Suscripción al carrito (Nano Stores)
    cartItems.subscribe((items: readonly any[]) => {
      const totalItems = items.reduce((sum, item) => sum + item.quantity, 0);
      const totalPrice = items.reduce((sum, item) => sum + (item.price * item.quantity), 0);

      if (countEl) countEl.textContent = totalItems.toString();
      if (totalEl) totalEl.textContent = totalPrice.toFixed(2) + '€';

      const btn = document.getElementById('mobile-cart-btn');
      if (btn && totalItems > 0) {
        btn.classList.add('scale-[1.02]');
        setTimeout(() => btn.classList.remove('scale-[1.02]'), 150);
      }
    });

    // Lógica de Filtrado corregida con colores corporativos
    const categoryButtons = document.querySelectorAll('.category-btn');
    const dishCards = document.querySelectorAll('.dish-card'); 
    
    categoryButtons.forEach(button => {
      button.addEventListener('click', () => {
        const buttonText = button.textContent?.trim().toLowerCase();
        const filterCategory = buttonText === 'todos' ? 'all' : buttonText;

        // Filtrar tarjetas
        dishCards.forEach(card => {
          const cardCategory = (card.getAttribute('data-category') || '').trim().toLowerCase();
          if (filterCategory === 'all' || cardCategory === filterCategory) {
            card.classList.remove('hidden');
            card.classList.add('flex'); 
          } else {
            card.classList.add('hidden');
            card.classList.remove('flex'); 
          }
        });

        // Actualizar estilos de botones (Usando tu paleta)
        categoryButtons.forEach(btn => {
          btn.classList.remove('bg-tpv-accent', 'text-white', 'border-tpv-accent', 'shadow-lg');
          btn.classList.add('bg-tpv-bg', 'text-tpv-text-muted', 'border-tpv-border');
        });

        button.classList.add('bg-tpv-accent', 'text-white', 'border-tpv-accent', 'shadow-lg');
        button.classList.remove('bg-tpv-bg', 'text-tpv-text-muted', 'border-tpv-border');
      });
    });
  });
</script>