---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Iniciar Sesión - CookFlow">
  <div class="min-h-screen flex items-center justify-center bg-tpv-bg p-4 relative overflow-hidden font-sans">
    
    <div class="absolute top-[-10%] left-[-10%] w-96 h-96 bg-tpv-accent/20 rounded-full blur-3xl"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-96 h-96 bg-tpv-accent/10 rounded-full blur-3xl"></div>

    <div class="w-full max-w-md bg-tpv-surface border border-tpv-border rounded-3xl shadow-2xl p-8 relative z-10">
      
      <div class="text-center mb-10">
        <h1 class="text-5xl font-black text-transparent bg-clip-text bg-linear-to-r from-tpv-accent to-blue-400 mb-3 tracking-tighter">
          CookFlow
        </h1>
        <p class="text-tpv-text-muted font-bold uppercase text-xs tracking-widest">Acceso al sistema TPV</p>
      </div>

      <div id="error-alert" class="hidden mb-6 bg-red-500/10 border border-red-500/30 text-red-400 p-4 rounded-2xl text-sm font-bold text-center transition-all animate-pulse">
        Credenciales incorrectas
      </div>

      <form id="login-form" class="space-y-6">
        
        <div>
          <label for="email" class="block text-sm font-black text-tpv-text-muted mb-2 uppercase tracking-wide">Correo Electrónico</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            required
            placeholder="admin@cookflow.com"
            class="w-full bg-tpv-bg text-tpv-text border border-tpv-border rounded-2xl px-5 py-4 focus:outline-none focus:ring-2 focus:ring-tpv-accent/50 focus:border-tpv-accent transition-all placeholder:text-tpv-text-muted/30"
          >
        </div>

        <div>
          <label for="password" class="block text-sm font-black text-tpv-text-muted mb-2 uppercase tracking-wide">Contraseña</label>
          <input 
            type="password" 
            id="password" 
            name="password" 
            required
            placeholder="••••••••"
            class="w-full bg-tpv-bg text-tpv-text border border-tpv-border rounded-2xl px-5 py-4 focus:outline-none focus:ring-2 focus:ring-tpv-accent/50 focus:border-tpv-accent transition-all placeholder:text-tpv-text-muted/30"
          >
        </div>

        <button 
          type="submit" 
          id="submit-btn"
          class="w-full bg-tpv-accent hover:bg-tpv-accent-hover text-white font-black text-lg py-4 rounded-2xl shadow-xl shadow-tpv-accent/25 transition-all active:scale-95 flex justify-center items-center gap-3 mt-8 border border-white/10"
        >
          <span id="btn-text">Entrar al Sistema</span>
          
          <svg id="btn-spinner" class="hidden animate-spin h-6 w-6 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </button>
        
      </form>
    </div>
  </div>
</Layout>

<script>
  // Tu lógica de TS se mantiene igual porque estaba perfecta...
  const backendUrl = import.meta.env.PUBLIC_BACKEND_URL;

  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('login-form') as HTMLFormElement;
    const errorAlert = document.getElementById('error-alert');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const btnText = document.getElementById('btn-text');
    const btnSpinner = document.getElementById('btn-spinner');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errorAlert) errorAlert.classList.add('hidden');
      submitBtn.disabled = true;
      if (btnText) btnText.textContent = 'Verificando...';
      if (btnSpinner) btnSpinner.classList.remove('hidden');

      const formData = new FormData(form);
      const email = formData.get('email');
      const password = formData.get('password');

      try {
        const response = await fetch(`${backendUrl}/api/login`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ email, password })
        });

        const data = await response.json();
        if (!response.ok) throw new Error(data.message || 'Credenciales incorrectas');

        localStorage.setItem('auth_token', data.token);
        localStorage.setItem('user_data', JSON.stringify(data.user));

        window.location.href = data.user.role === 'admin' ? '/admin' : '/';

      } catch (error: any) {
        if (errorAlert) {
          errorAlert.textContent = error.message;
          errorAlert.classList.remove('hidden');
        }
      } finally {
        submitBtn.disabled = false;
        if (btnText) btnText.textContent = 'Entrar al Sistema';
        if (btnSpinner) btnSpinner.classList.add('hidden');
      }
    });
  });
</script>