---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Iniciar Sesión - CookFlow">
  <div class="min-h-screen flex items-center justify-center bg-tpv-bg p-4 relative overflow-hidden">
    
    <div class="absolute top-[-10%] left-[-10%] w-96 h-96 bg-tpv-accent/20 rounded-full blur-3xl"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-96 h-96 bg-tpv-accent/10 rounded-full blur-3xl"></div>

    <div class="w-full max-w-md bg-tpv-surface border border-tpv-border rounded-3xl shadow-2xl p-8 relative z-10">
      
      <div class="text-center mb-8">
        <h1 class="text-4xl font-black text-transparent bg-clip-text bg-linear-to-r from-tpv-accent to-blue-500 mb-2">
          CookFlow
        </h1>
        <p class="text-gray-500 font-medium">Acceso al sistema TPV</p>
      </div>

      <div id="error-alert" class="hidden mb-6 bg-red-500/10 border border-red-500/50 text-red-600 p-4 rounded-xl text-sm font-medium text-center transition-all">
        Credenciales incorrectas. Inténtalo de nuevo.
      </div>

      <form id="login-form" class="space-y-5">
        
        <div>
          <label for="email" class="block text-sm font-bold text-gray-700 mb-1.5">Correo Electrónico</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            required
            placeholder="admin@cookflow.com"
            class="w-full bg-tpv-bg border border-tpv-border rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-tpv-accent/50 focus:border-tpv-accent transition-all"
          >
        </div>

        <div>
          <label for="password" class="block text-sm font-bold text-gray-700 mb-1.5">Contraseña</label>
          <input 
            type="password" 
            id="password" 
            name="password" 
            required
            placeholder="••••••••"
            class="w-full bg-tpv-bg border border-tpv-border rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-tpv-accent/50 focus:border-tpv-accent transition-all"
          >
        </div>

        <button 
          type="submit" 
          id="submit-btn"
          class="w-full bg-tpv-accent hover:bg-tpv-accent-hover text-white font-bold text-lg py-3.5 rounded-xl shadow-lg shadow-tpv-accent/30 transition-all active:scale-95 flex justify-center items-center gap-2 mt-4"
        >
          <span id="btn-text">Entrar al Sistema</span>
          
          <svg id="btn-spinner" class="hidden animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </button>
        
      </form>
    </div>
  </div>
</Layout>

<script>
  // URL base de tu backend Laravel
  const backendUrl = import.meta.env.PUBLIC_BACKEND_URL || 'http://127.0.0.1:8000';

  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('login-form') as HTMLFormElement;
    const errorAlert = document.getElementById('error-alert');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const btnText = document.getElementById('btn-text');
    const btnSpinner = document.getElementById('btn-spinner');

    if (!form) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault(); // 🚨 CRÍTICO: Evita que la página se recargue

      // Ocultamos errores y mostramos estado de carga
      if (errorAlert) errorAlert.classList.add('hidden');
      submitBtn.disabled = true;
      if (btnText) btnText.textContent = 'Verificando...';
      if (btnSpinner) btnSpinner.classList.remove('hidden');

      // Extraemos los datos del formulario
      const formData = new FormData(form);
      const email = formData.get('email');
      const password = formData.get('password');

      try {
        // 1. Petición POST a Laravel Sanctum
        const response = await fetch(`${backendUrl}/api/login`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            // El Accept: application/json es vital para que Laravel no intente redirigirnos si hay error
            'Accept': 'application/json', 
          },
          body: JSON.stringify({ email, password })
        });

        const data = await response.json();

        if (!response.ok) {
          // Si el servidor responde con 401 (No autorizado) o 422 (Validación)
          throw new Error(data.message || 'Credenciales incorrectas');
        }

        // 2. ¡Login exitoso! Guardamos el token de Sanctum
        // (Asumimos que Nizar devuelve un JSON con { token: '1|xyz...', user: { role: 'admin' } })
        localStorage.setItem('auth_token', data.token);
        
        // Guardamos también datos básicos del usuario por si los necesitamos en la UI
        localStorage.setItem('user_data', JSON.stringify(data.user));

        // 3. Lógica de redirección según el rol
        if (data.user.role === 'admin') {
          window.location.href = '/admin'; // Redirige al panel de control (que crearemos luego)
        } else {
          window.location.href = '/'; // Redirige al TPV
        }

      } catch (error: any) {
        // Mostramos el mensaje de error visualmente
        if (errorAlert) {
          errorAlert.textContent = error.message;
          errorAlert.classList.remove('hidden');
        }
      } finally {
        // Restauramos el botón a su estado original
        submitBtn.disabled = false;
        if (btnText) btnText.textContent = 'Entrar al Sistema';
        if (btnSpinner) btnSpinner.classList.add('hidden');
      }
    });
  });
</script>