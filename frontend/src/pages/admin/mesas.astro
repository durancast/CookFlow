---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Gestión de Mesas">
  <header class="flex justify-between items-center mb-8">
    <div>
      <h1 class="text-3xl font-bold text-tpv-text tracking-tight font-sans">Gestión de Mesas</h1>
      <p class="text-tpv-text-muted mt-1 font-medium">Configura la distribución de tu sala</p>
    </div>
    
    <button id="open-modal-btn" class="bg-tpv-accent hover:bg-tpv-accent-hover text-white px-6 py-3 rounded-xl font-bold shadow-lg shadow-tpv-accent/20 transition-all flex items-center gap-2 active:scale-95">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M12 4v16m8-8H4" /></svg>
      Añadir Mesa
    </button>
  </header>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="tables-grid"></div>

  <div id="table-modal" class="hidden fixed inset-0 z-50 items-center justify-center p-4" style="display: none;">
    <div id="modal-backdrop" class="absolute inset-0 bg-tpv-bg/80 backdrop-blur-sm transition-opacity"></div>
    
    <div class="bg-tpv-surface w-full max-w-sm rounded-3xl shadow-2xl z-10 p-6 border border-tpv-border transform transition-all">
      <div class="flex justify-between items-center mb-6">
        <h2 id="modal-title" class="text-2xl font-bold text-tpv-text">Nueva Mesa</h2>
        <button id="close-modal-btn" type="button" class="text-tpv-text-muted hover:text-tpv-accent transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
      </div>

      <form id="add-table-form" class="space-y-4">
        <div>
          <label class="block text-sm font-bold text-tpv-text-muted mb-1.5 uppercase tracking-wide">Número de Mesa</label>
          <input type="number" name="number" id="table-number-input" required min="1"
            class="w-full bg-tpv-bg text-tpv-text border border-tpv-border rounded-xl px-4 py-2.5 outline-none focus:ring-2 focus:ring-tpv-accent transition-all">
        </div>
        
        <div>
          <label class="block text-sm font-bold text-tpv-text-muted mb-1.5 uppercase tracking-wide">Capacidad (Pax)</label>
          <input type="number" name="capacity" id="table-capacity-input" value="2" min="1" required 
            class="w-full bg-tpv-bg text-tpv-text border border-tpv-border rounded-xl px-4 py-2.5 outline-none focus:ring-2 focus:ring-tpv-accent transition-all">
        </div>

        <button type="submit" id="submit-table-btn" class="w-full bg-tpv-accent hover:bg-tpv-accent-hover text-white font-black py-4 rounded-xl mt-6 transition-all shadow-lg shadow-tpv-accent/20 flex justify-center items-center gap-2">
          <span id="btn-text-table">Guardar Mesa</span>
        </button>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  declare global {
    interface Window {
      showToast: (message: string, type?: 'success' | 'error') => void;
    }
  }

  const backendUrl = import.meta.env.PUBLIC_BACKEND_URL || "http://127.0.0.1:8000";
  let isEditing = false;
  let currentTableId: string | null = null;

  const modal = document.getElementById('table-modal');
  const form = document.getElementById('add-table-form') as HTMLFormElement | null;
  const modalTitle = document.getElementById('modal-title');
  const btnText = document.getElementById('btn-text-table');

  // --- 1. FUNCIÓN PARA ABRIR/CERRAR EL MODAL ---
  function toggleModal(show: boolean, editMode = false) {
    if (!modal || !form) return;

    if (show) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      modal.style.display = 'flex';
      if (!editMode) {
        isEditing = false;
        currentTableId = null;
        form.reset();
        if (modalTitle) modalTitle.textContent = "Nueva Mesa";
        if (btnText) btnText.textContent = "Guardar Mesa";
      }
    } else {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      modal.style.display = 'none';
      form.reset();
    }
  }

  // Listeners de los botones del modal
  document.getElementById('open-modal-btn')?.addEventListener('click', () => toggleModal(true));
  document.getElementById('close-modal-btn')?.addEventListener('click', () => toggleModal(false));
  document.getElementById('modal-backdrop')?.addEventListener('click', () => toggleModal(false));

  // --- 2. CARGAR LAS MESAS ---
  async function loadTables() {
    const grid = document.getElementById('tables-grid');
    if (!grid) return;

    try {
      const response = await fetch(`${backendUrl}/api/tables`);
      const tables = await response.json();
      grid.innerHTML = '';

      tables.forEach((table: any) => {
        const card = document.createElement('div');
        card.className = "bg-tpv-surface border border-tpv-border rounded-3xl p-6 hover:border-tpv-accent transition-all group relative animate-in fade-in zoom-in-95";
        card.innerHTML = `
          <div class="p-3 bg-tpv-bg rounded-2xl text-tpv-accent w-fit mb-4">
             <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path d="M4 6h16M4 10h16M4 14h16M4 18h16" /></svg>
          </div>
          <h3 class="text-2xl font-black text-tpv-text">Mesa ${table.number}</h3>
          <p class="text-xs font-bold text-tpv-text-muted uppercase tracking-widest mt-1">Pax: ${table.capacity}</p>
          
          <div class="absolute top-4 right-4 flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
            <button class="edit-table-btn text-tpv-accent p-2 hover:bg-tpv-accent/10 rounded-lg font-bold" 
                    data-id="${table.id}" data-number="${table.number}" data-capacity="${table.capacity}">EDITAR</button>
            <button class="delete-table-btn text-red-400 p-2 hover:bg-red-500/10 rounded-lg font-bold" 
                    data-id="${table.id}">BORRAR</button>
          </div>
        `;
        grid.appendChild(card);
      });

      attachTableEvents();
    } catch (e) { console.error("Error al cargar mesas:", e); }
  }

  // --- 3. EVENTOS PARA LOS BOTONES DE CADA MESA ---
  function attachTableEvents() {
    // BORRAR
    document.querySelectorAll('.delete-table-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const id = target.getAttribute('data-id');
        if (!id || !confirm('¿Estás seguro de eliminar esta mesa?')) return;
        
        const token = localStorage.getItem('auth_token');
        await fetch(`${backendUrl}/api/tables/${id}`, {
          method: 'DELETE',
          headers: { 'Authorization': `Bearer ${token}` }
        });
        loadTables();
      });
    });

    // EDITAR (Rellenar el modal)
    document.querySelectorAll('.edit-table-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        if (!form) return;

        isEditing = true;
        currentTableId = target.getAttribute('data-id');
        
        toggleModal(true, true);
        
        if (modalTitle) modalTitle.textContent = "Editar Mesa " + target.getAttribute('data-number');
        if (btnText) btnText.textContent = "Actualizar Mesa";
        
        (form.elements.namedItem('number') as HTMLInputElement).value = target.getAttribute('data-number') || '';
        (form.elements.namedItem('capacity') as HTMLInputElement).value = target.getAttribute('data-capacity') || '';
      });
    });
  }

  // --- 4. ENVIAR EL FORMULARIO ---
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !btnText) return;

    const formData = new FormData(form);
    const token = localStorage.getItem('auth_token');

    // 1. Preparamos el objeto de datos
    // Usamos Record<string, any> para que TS nos deje añadir el _method sin quejarse
    const tableData: Record<string, any> = {
      number: parseInt(formData.get('number') as string),
      capacity: parseInt(formData.get('capacity') as string)
    };

    // 2. Definimos la URL
    const url = isEditing 
      ? `${backendUrl}/api/tables/${currentTableId}` 
      : `${backendUrl}/api/tables`;
    
    // 3. 🔥 EL TRUCO: Siempre usamos POST como método real del navegador
    // Pero si editamos, añadimos el campo _method para que Laravel lo entienda
    if (isEditing) {
      tableData['_method'] = 'PUT'; 
    }

    console.log(`🚀 Enviando a ${url}:`, tableData);

    btnText.textContent = "Procesando...";

    try {
      const res = await fetch(url, {
        method: 'POST', // 👈 Cambiado a POST siempre
        headers: { 
          'Authorization': `Bearer ${token}`, 
          'Content-Type': 'application/json',
          'Accept': 'application/json' 
        },
        body: JSON.stringify(tableData)
      });

      if (res.ok) {
        if (window.showToast) window.showToast(isEditing ? 'Mesa actualizada ✅' : 'Mesa creada ✅');
        toggleModal(false);
        loadTables();
      } else {
        const err = await res.json();
        console.error("🚨 Error del servidor:", err);
        if (window.showToast) window.showToast(err.message || 'Error al guardar', 'error');
      }
    } catch (e) {
      console.error("🚨 Error de conexión:", e);
      if (window.showToast) window.showToast('Error de conexión con el servidor', 'error');
    } finally {
      if (btnText) btnText.textContent = isEditing ? "Actualizar Mesa" : "Guardar Mesa";
    }
  });

  // Carga inicial
  loadTables();
</script>