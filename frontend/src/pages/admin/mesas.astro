---
import AdminLayout from '../../layouts/AdminLayout.astro';
const role = Astro.cookies.get('user_role')?.value ?? '';
const canEdit = role === 'admin';
---

<AdminLayout title="Gestión de Mesas">
  <header class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-3xl font-bold text-tpv-text tracking-tight">Gestión de Mesas</h1>
      <p class="text-tpv-text-muted mt-1 text-sm font-medium">Estado en tiempo real de la sala</p>
    </div>
    <div class="flex items-center gap-3">
      <button id="refresh-btn"
        class="p-2.5 rounded-xl border border-tpv-border text-tpv-text-muted hover:text-tpv-accent hover:border-tpv-accent transition-all"
        title="Actualizar">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
        </svg>
      </button>
      {canEdit && (
        <button id="open-modal-btn"
          class="bg-tpv-accent hover:bg-tpv-accent-hover text-white px-5 py-2.5 rounded-xl font-bold shadow-lg shadow-tpv-accent/20 transition-all flex items-center gap-2 active:scale-95">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M12 4v16m8-8H4"/></svg>
          Añadir Mesa
        </button>
      )}
    </div>
  </header>

  <!-- Status summary bar -->
  <div id="status-bar" class="flex flex-wrap gap-3 mb-6">
    <div class="flex items-center gap-2 px-4 py-2 bg-tpv-surface border border-tpv-border rounded-xl text-sm font-bold">
      <span class="w-2 h-2 rounded-full bg-tpv-border"></span>
      <span class="text-tpv-text-muted">Cargando…</span>
    </div>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4" id="tables-grid"></div>

  <!-- Modal -->
  <div id="table-modal" class="hidden fixed inset-0 z-50 items-center justify-center p-4" style="display:none">
    <div id="modal-backdrop" class="absolute inset-0 bg-tpv-bg/80 backdrop-blur-sm"></div>
    <div class="bg-tpv-surface w-full max-w-sm rounded-3xl shadow-2xl z-10 p-6 border border-tpv-border">
      <div class="flex justify-between items-center mb-6">
        <h2 id="modal-title" class="text-2xl font-bold text-tpv-text">Nueva Mesa</h2>
        <button id="close-modal-btn" type="button" class="text-tpv-text-muted hover:text-tpv-accent transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
      <form id="add-table-form" class="space-y-4">
        <div>
          <label class="block text-xs font-black text-tpv-text-muted mb-1.5 uppercase tracking-wider">Número de Mesa</label>
          <input type="number" name="number" id="table-number-input" required min="1"
            class="w-full bg-tpv-bg text-tpv-text border border-tpv-border rounded-xl px-4 py-2.5 outline-none focus:ring-2 focus:ring-tpv-accent transition-all [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none">
        </div>
        <div>
          <label class="block text-xs font-black text-tpv-text-muted mb-1.5 uppercase tracking-wider">Capacidad (Pax)</label>
          <input type="number" name="capacity" id="table-capacity-input" value="2" min="1" required
            class="w-full bg-tpv-bg text-tpv-text border border-tpv-border rounded-xl px-4 py-2.5 outline-none focus:ring-2 focus:ring-tpv-accent transition-all [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none">
        </div>
        <button type="submit" id="submit-table-btn"
          class="w-full bg-tpv-accent hover:bg-tpv-accent-hover text-white font-black py-3.5 rounded-xl mt-2 transition-all shadow-lg shadow-tpv-accent/20">
          <span id="btn-text-table">Guardar Mesa</span>
        </button>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  const canEdit = document.cookie.match(/user_role=([^;]+)/)?.[1] === 'admin';
  const backendUrl = import.meta.env.PUBLIC_BACKEND_URL || 'http://127.0.0.1:8000';
  let isEditing = false;
  let currentTableId: string | null = null;

  const modal     = document.getElementById('table-modal')!;
  const form      = document.getElementById('add-table-form') as HTMLFormElement;
  const modalTitle = document.getElementById('modal-title')!;
  const btnText   = document.getElementById('btn-text-table')!;

  // ── Modal helpers ────────────────────────────────────────────────────────────
  function toggleModal(show: boolean, editMode = false) {
    if (show) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      modal.style.display = 'flex';
      if (!editMode) {
        isEditing = false;
        currentTableId = null;
        form.reset();
        modalTitle.textContent = 'Nueva Mesa';
        btnText.textContent = 'Guardar Mesa';
      }
    } else {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      modal.style.display = 'none';
      form.reset();
    }
  }

  document.getElementById('open-modal-btn')?.addEventListener('click', () => toggleModal(true));
  document.getElementById('close-modal-btn')?.addEventListener('click', () => toggleModal(false));
  document.getElementById('modal-backdrop')?.addEventListener('click', () => toggleModal(false));

  // ── Status helpers ───────────────────────────────────────────────────────────
  type Status = 'free' | 'occupied' | 'pending';

  const STATUS_LABEL: Record<Status, string>  = { free: 'Libre', occupied: 'Ocupada', pending: 'Pendiente' };
  const STATUS_DOT: Record<Status, string>    = { free: 'bg-green-500', occupied: 'bg-red-500 animate-pulse', pending: 'bg-yellow-500 animate-pulse' };
  const STATUS_BADGE: Record<Status, string>  = { free: 'text-green-500 bg-green-500/10 border-green-500/20', occupied: 'text-red-400 bg-red-500/10 border-red-500/20', pending: 'text-yellow-500 bg-yellow-500/10 border-yellow-500/20' };
  const STATUS_BORDER: Record<Status, string> = { free: 'border-tpv-border hover:border-tpv-accent/50', occupied: 'border-red-500/30 hover:border-red-500/60', pending: 'border-yellow-500/30 hover:border-yellow-500/60' };

  // ── Load tables ──────────────────────────────────────────────────────────────
  async function loadTables() {
    const grid = document.getElementById('tables-grid')!;
    const bar  = document.getElementById('status-bar')!;
    const token = localStorage.getItem('auth_token');

    try {
      const res = await fetch(`${backendUrl}/api/tables`, {
        headers: { Authorization: `Bearer ${token}`, Accept: 'application/json' },
      });
      const tables: any[] = await res.json();

      const counts = { free: 0, occupied: 0, pending: 0 };
      tables.forEach(t => { if (t.status in counts) counts[t.status as Status]++; });

      bar.innerHTML = `
        <div class="flex items-center gap-2 px-4 py-2 bg-tpv-surface border border-tpv-border rounded-xl text-sm font-bold">
          <span class="w-2 h-2 rounded-full bg-green-500"></span>
          <span class="text-tpv-text">${counts.free} <span class="text-tpv-text-muted font-medium">libre${counts.free !== 1 ? 's' : ''}</span></span>
        </div>
        <div class="flex items-center gap-2 px-4 py-2 bg-tpv-surface border border-tpv-border rounded-xl text-sm font-bold">
          <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
          <span class="text-tpv-text">${counts.occupied} <span class="text-tpv-text-muted font-medium">ocupada${counts.occupied !== 1 ? 's' : ''}</span></span>
        </div>
        <div class="flex items-center gap-2 px-4 py-2 bg-tpv-surface border border-tpv-border rounded-xl text-sm font-bold">
          <span class="w-2 h-2 rounded-full bg-yellow-500"></span>
          <span class="text-tpv-text">${counts.pending} <span class="text-tpv-text-muted font-medium">pendiente${counts.pending !== 1 ? 's' : ''}</span></span>
        </div>
        <span class="text-xs text-tpv-text-muted ml-auto self-center">${tables.length} mesa${tables.length !== 1 ? 's' : ''} en total</span>
      `;

      grid.innerHTML = '';
      tables.forEach((table: any) => {
        const status: Status = table.status ?? 'free';
        const bell = table.call_waiter
          ? `<span class="absolute -top-1.5 -right-1.5 w-5 h-5 bg-red-500 rounded-full flex items-center justify-center text-[10px] animate-pulse shadow-lg shadow-red-500/30">🔔</span>`
          : '';
        const card = document.createElement('div');
        card.className = `relative bg-tpv-surface border-2 ${STATUS_BORDER[status]} rounded-3xl p-5 group transition-all animate-in fade-in zoom-in-95`;
        card.innerHTML = `
          ${bell}

          <div class="flex items-center justify-between mb-5">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg border text-[10px] font-black uppercase tracking-wider ${STATUS_BADGE[status]}">
              <span class="w-1.5 h-1.5 rounded-full ${STATUS_DOT[status]}"></span>
              ${STATUS_LABEL[status]}
            </span>
            ${canEdit ? `<div class="flex gap-0.5 opacity-0 group-hover:opacity-100 transition-opacity">
              <button class="edit-table-btn p-1.5 rounded-lg hover:bg-tpv-accent/10 text-tpv-accent text-[10px] font-black transition-colors"
                      data-id="${table.id}" data-number="${table.number}" data-capacity="${table.capacity}">
                EDITAR
              </button>
              <button class="delete-table-btn p-1.5 rounded-lg hover:bg-red-500/10 text-red-400 text-[10px] font-black transition-colors"
                      data-id="${table.id}">
                BORRAR
              </button>
            </div>` : ''}
          </div>

          <p class="text-5xl font-black font-mono text-tpv-text leading-none">${table.number}</p>

          <div class="flex items-center justify-between mt-3">
            <div class="flex items-center gap-1 text-tpv-text-muted">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span class="text-xs font-bold">${table.capacity} pax</span>
            </div>
            ${status !== 'free' ? `
            <a href="/tpv" class="text-[10px] font-black text-tpv-accent hover:underline uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-opacity">
              Ver TPV →
            </a>` : ''}
          </div>
        `;
        grid.appendChild(card);
      });

      attachTableEvents();
    } catch (e) {}
  }

  // ── Card button events ───────────────────────────────────────────────────────
  function attachTableEvents() {
    document.querySelectorAll('.delete-table-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const id = target.getAttribute('data-id');
        if (!id || !confirm('¿Eliminar esta mesa?')) return;
        const token = localStorage.getItem('auth_token');
        await fetch(`${backendUrl}/api/tables/${id}`, {
          method: 'DELETE',
          headers: { Authorization: `Bearer ${token}` },
        });
        loadTables();
      });
    });

    document.querySelectorAll('.edit-table-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        isEditing = true;
        currentTableId = target.getAttribute('data-id');
        toggleModal(true, true);
        modalTitle.textContent = `Editar Mesa ${target.getAttribute('data-number')}`;
        btnText.textContent = 'Actualizar Mesa';
        (form.elements.namedItem('number') as HTMLInputElement).value = target.getAttribute('data-number') || '';
        (form.elements.namedItem('capacity') as HTMLInputElement).value = target.getAttribute('data-capacity') || '';
      });
    });
  }

  // ── Submit form ──────────────────────────────────────────────────────────────
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const token = localStorage.getItem('auth_token');
    const formData = new FormData(form);
    const payload: Record<string, any> = {
      number:   parseInt(formData.get('number') as string),
      capacity: parseInt(formData.get('capacity') as string),
    };
    if (isEditing) payload._method = 'PUT';

    const url = isEditing
      ? `${backendUrl}/api/tables/${currentTableId}`
      : `${backendUrl}/api/tables`;

    btnText.textContent = 'Procesando…';
    try {
      const res = await fetch(url, {
        method: 'POST',
        headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
      });
      if (res.ok) {
        window.showToast?.(isEditing ? 'Mesa actualizada' : 'Mesa creada', 'success');
        toggleModal(false);
        loadTables();
      } else {
        const err = await res.json();
        window.showToast?.(err.message || 'Error al guardar', 'error');
      }
    } catch {
      window.showToast?.('Error de conexión', 'error');
    } finally {
      btnText.textContent = isEditing ? 'Actualizar Mesa' : 'Guardar Mesa';
    }
  });

  document.getElementById('refresh-btn')?.addEventListener('click', loadTables);

  loadTables();
  setInterval(loadTables, 5000);
</script>
