---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Gestión de Productos">
  <header class="flex justify-between items-center mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-800">Catálogo de Productos</h1>
      <p class="text-gray-500 mt-1">Gestiona los platos y bebidas del restaurante</p>
    </div>
    
    <button class="bg-tpv-accent hover:bg-tpv-accent-hover text-white px-6 py-3 rounded-xl font-bold shadow-lg shadow-tpv-accent/30 transition-all flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
      Añadir Producto
    </button>
  </header>

  <div class="bg-tpv-surface border border-tpv-border rounded-2xl shadow-sm overflow-hidden">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-gray-50 border-b border-tpv-border">
          <th class="p-4 font-semibold text-gray-600">Imagen</th>
          <th class="p-4 font-semibold text-gray-600">Nombre</th>
          <th class="p-4 font-semibold text-gray-600">Categoría</th>
          <th class="p-4 font-semibold text-gray-600">Precio</th>
          <th class="p-4 font-semibold text-gray-600 text-right">Acciones</th>
        </tr>
      </thead>
      <tbody id="products-table-body" class="divide-y divide-tpv-border">
        <tr>
          <td colspan="5" class="p-8 text-center text-gray-500">
            Cargando catálogo...
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</AdminLayout>

<script>
  const backendUrl = 'http://127.0.0.1:8000';

  async function loadAdminProducts() {
    try {
      // Como documentó Nizar, esta ruta es GET y es PÚBLICA, no necesita el Bearer Token para leer.
      // (Pero si fuera privada, aquí añadiríamos el header Authorization).
      const response = await fetch(`${backendUrl}/api/products`);
      const products = await response.json();
      
      const tbody = document.getElementById('products-table-body');
      if (!tbody) return;

      tbody.innerHTML = ''; // Limpiar estado de "Cargando..."

      products.forEach((product: { image: string; name: string; category: { name: string }; price: string | number }) => {
        const imageUrl = product.image 
          ? `${backendUrl}/storage/products/${product.image}` 
          : 'https://placehold.co/100x100?text=Sin+Foto';

        const tr = document.createElement('tr');
        tr.className = "hover:bg-gray-50 transition-colors";
        tr.innerHTML = `
          <td class="p-4">
            <img src="${imageUrl}" alt="${product.name}" class="w-12 h-12 rounded-lg object-cover border border-tpv-border">
          </td>
          <td class="p-4 font-medium text-gray-800">${product.name}</td>
          <td class="p-4 text-gray-500">
            <span class="bg-gray-100 px-3 py-1 rounded-full text-xs font-semibold border border-gray-200">
              ${product.category.name}
            </span>
          </td>
          <td class="p-4 font-mono font-bold text-gray-700">${parseFloat(String(product.price)).toFixed(2)}€</td>
          <td class="p-4 text-right space-x-2">
            <button class="text-blue-500 hover:text-blue-700 font-medium px-2 py-1 bg-blue-50 rounded-md transition-colors">Editar</button>
            <button class="text-red-500 hover:text-red-700 font-medium px-2 py-1 bg-red-50 rounded-md transition-colors">Borrar</button>
          </td>
        `;
        tbody.appendChild(tr);
      });

    } catch (error) {
      console.error("Error cargando productos en el admin", error);
    }
  }

  // Ejecutamos al cargar
  loadAdminProducts();
</script>