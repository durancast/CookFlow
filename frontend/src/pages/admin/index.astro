---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Gestión de Productos">
  <header class="flex justify-between items-center mb-8">
    <div>
      <h1 class="text-3xl font-bold text-tpv-text font-sans tracking-tight">Catálogo de Productos</h1>
      <p class="text-tpv-text-muted mt-1">Gestiona los platos y bebidas del restaurante</p>
    </div>
    
    <button id="open-modal-btn" class="bg-tpv-accent hover:bg-tpv-accent-hover text-tpv-text px-6 py-3 rounded-xl font-bold shadow-lg shadow-tpv-accent/20 transition-all flex items-center gap-2 active:scale-95">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" /></svg>
      Añadir Producto
    </button>
  </header>

  <div class="bg-tpv-surface border border-tpv-border rounded-2xl shadow-sm overflow-hidden">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-tpv-bg/50 border-b border-tpv-border">
          <th class="p-4 font-bold text-xs uppercase tracking-widest text-tpv-text-muted">Imagen</th>
          <th class="p-4 font-bold text-xs uppercase tracking-widest text-tpv-text-muted">Nombre</th>
          <th class="p-4 font-bold text-xs uppercase tracking-widest text-tpv-text-muted">Categoría</th>
          <th class="p-4 font-bold text-xs uppercase tracking-widest text-tpv-text-muted">Precio</th>
          <th class="p-4 font-bold text-xs uppercase tracking-widest text-tpv-text-muted text-right">Acciones</th>
        </tr>
      </thead>
      <tbody id="products-table-body" class="divide-y divide-tpv-border"></tbody>
    </table>
  </div>

  <div id="product-modal" class="hidden fixed inset-0 z-50 items-center justify-center p-4" style="display: none;">
    <div id="modal-backdrop" class="absolute inset-0 bg-tpv-bg/80 backdrop-blur-sm transition-opacity"></div>
    <div class="bg-tpv-surface w-full max-w-md rounded-3xl shadow-2xl z-10 p-6 border border-tpv-border transform transition-all">
      <div class="flex justify-between items-center mb-6">
        <h2 id="modal-title" class="text-2xl font-bold text-tpv-text">Nuevo Producto</h2>
        <button id="close-modal-btn" type="button" class="text-tpv-text-muted hover:text-tpv-accent transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
      <form id="add-product-form" class="space-y-4">
        <div>
          <label class="block text-sm font-bold text-tpv-text-muted mb-1.5 uppercase tracking-wide">Nombre del plato</label>
          <input type="text" name="name" required class="w-full bg-tpv-bg text-tpv-text border border-tpv-border rounded-xl px-4 py-2.5 outline-none focus:ring-2 focus:ring-tpv-accent transition-all">
        </div>
        <div class="flex gap-4">
          <div class="w-1/2">
            <label class="block text-sm font-bold text-tpv-text-muted mb-1.5 uppercase tracking-wide">Precio (€)</label>
            <input type="number" step="0.01" name="price" required class="w-full bg-tpv-bg text-tpv-text border border-tpv-border rounded-xl px-4 py-2.5 outline-none">
          </div>
          <div class="w-1/2">
            <label class="block text-sm font-bold text-tpv-text-muted mb-1.5 uppercase tracking-wide">Categoría</label>
            <select name="category_id" required class="w-full bg-tpv-bg text-tpv-text border border-tpv-border rounded-xl px-4 py-2.5 outline-none cursor-pointer">
              <option value="1">Entrantes</option>
              <option value="2">Principales</option>
              <option value="3">Bebidas</option>
              <option value="4">Postres</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-sm font-bold text-tpv-text-muted mb-1.5 uppercase tracking-wide">Imagen (opcional)</label>
          <input type="file" name="image" accept="image/*" class="w-full text-sm text-tpv-text-muted file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:bg-tpv-accent file:text-white cursor-pointer">
        </div>
        <button type="submit" id="submit-product-btn" class="w-full bg-tpv-accent hover:bg-tpv-accent-hover text-white font-black py-4 rounded-xl mt-6 transition-all shadow-lg shadow-tpv-accent/20">
          <span id="btn-text-product">Guardar Producto</span>
        </button>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  interface Category { id: number; name: string; }
  interface Product { id: number; name: string; price: number; category_id: number; image: string | null; category: Category; }

  const backendUrl = import.meta.env.PUBLIC_BACKEND_URL || "http://127.0.0.1:8000";
  let isEditing = false;
  let currentProductId: string | null = null;

  const modal = document.getElementById('product-modal');
  const form = document.getElementById('add-product-form') as HTMLFormElement | null;
  const modalTitle = document.getElementById('modal-title');
  const btnText = document.getElementById('btn-text-product');

  function toggleModal(show: boolean, editMode = false) {
    if (!modal || !form) return;
    if (show) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      modal.style.display = 'flex';
      if (!editMode) {
        isEditing = false;
        currentProductId = null;
        form.reset();
        if (modalTitle) modalTitle.textContent = "Nuevo Producto";
        if (btnText) btnText.textContent = "Guardar Producto";
      }
    } else {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      modal.style.display = 'none';
      form.reset();
    }
  }

  document.getElementById('open-modal-btn')?.addEventListener('click', () => toggleModal(true));
  document.getElementById('close-modal-btn')?.addEventListener('click', () => toggleModal(false));
  document.getElementById('modal-backdrop')?.addEventListener('click', () => toggleModal(false));

  async function loadAdminProducts() {
    const tbody = document.getElementById('products-table-body');
    if (!tbody) return;
    try {
      const response = await fetch(`${backendUrl}/api/products`);
      const products: Product[] = await response.json();
      tbody.innerHTML = '';
      products.forEach((product) => {
        const imageUrl = product.image ? `${backendUrl}/storage/products/${product.image}` : 'https://placehold.co/100x100?text=Sin+Foto';
        const tr = document.createElement('tr');
        tr.className = "hover:bg-tpv-bg/40 transition-all border-b border-tpv-border/50";
        tr.innerHTML = `
          <td class="p-4"><img src="${imageUrl}" class="w-12 h-12 rounded-lg object-cover"></td>
          <td class="p-4 font-bold text-tpv-text">${product.name}</td>
          <td class="p-4 text-xs uppercase font-black text-tpv-text-muted">${product.category.name}</td>
          <td class="p-4 font-mono font-black text-tpv-accent">${Number(product.price).toFixed(2)}€</td>
          <td class="p-4 text-right space-x-2">
            <button class="edit-btn text-tpv-accent hover:bg-tpv-accent/10 px-3 py-1.5 rounded-lg" data-id="${product.id}" data-name="${product.name}" data-price="${product.price}" data-category="${product.category_id}">Editar</button>
            <button class="delete-btn text-red-400 hover:bg-red-500/10 px-3 py-1.5 rounded-lg" data-id="${product.id}">Borrar</button>
          </td>`;
        tbody.appendChild(tr);
      });
      attachEventListeners();
    } catch (e) { console.error(e); }
  }

  function attachEventListeners() {
    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
        if (!id || !confirm('¿Eliminar producto?')) return;
        const token = localStorage.getItem('auth_token');
        await fetch(`${backendUrl}/api/products/${id}`, { method: 'DELETE', headers: { 'Authorization': `Bearer ${token}` }});
        loadAdminProducts();
      });
    });

    document.querySelectorAll('.edit-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const t = e.currentTarget as HTMLElement;
        if (!form) return;
        isEditing = true;
        currentProductId = t.getAttribute('data-id');
        toggleModal(true, true);
        if (modalTitle) modalTitle.textContent = "Editar Producto";
        if (btnText) btnText.textContent = "Actualizar Cambios";
        (form.elements.namedItem('name') as HTMLInputElement).value = t.getAttribute('data-name') || '';
        (form.elements.namedItem('price') as HTMLInputElement).value = t.getAttribute('data-price') || '';
        (form.elements.namedItem('category_id') as HTMLSelectElement).value = t.getAttribute('data-category') || '';
      });
    });
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form) return;
    const formData = new FormData(form);
    const token = localStorage.getItem('auth_token');
    if (isEditing) {
      formData.append('_method', 'PUT');
      if (!(form.elements.namedItem('image') as HTMLInputElement).files?.[0]) formData.delete('image');
    }
    const url = isEditing ? `${backendUrl}/api/products/${currentProductId}` : `${backendUrl}/api/products`;
    const res = await fetch(url, { method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Accept': 'application/json' }, body: formData });
    if (res.ok) { toggleModal(false); loadAdminProducts(); }
  });

  loadAdminProducts();
</script>