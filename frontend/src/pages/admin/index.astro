---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Panel de Administración">
  <div class="space-y-8">

    <!-- Header -->
    <header class="flex items-start justify-between">
      <div>
        <h1 id="greeting" class="text-3xl font-black text-tpv-text tracking-tight">Hola 👋</h1>
        <p class="text-tpv-text-muted mt-1 text-sm font-medium">Resumen de hoy en CookFlow</p>
      </div>
      <a href="/tpv"
        class="flex items-center gap-2 px-5 py-2.5 bg-tpv-accent hover:bg-tpv-accent-hover text-white font-black rounded-xl shadow-lg shadow-tpv-accent/20 transition-all active:scale-95 text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
        Abrir TPV
      </a>
    </header>

    <!-- KPI cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">

      <div class="bg-tpv-surface border border-tpv-border p-5 rounded-3xl">
        <div class="flex items-center justify-between mb-3">
          <div class="p-2.5 bg-green-500/10 text-green-500 rounded-2xl">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
        </div>
        <p class="text-tpv-text-muted text-[10px] font-black uppercase tracking-widest">Ventas de hoy</p>
        <p class="text-3xl font-black text-tpv-text mt-1 font-mono" id="stat-sales">—</p>
      </div>

      <div class="bg-tpv-surface border border-tpv-border p-5 rounded-3xl">
        <div class="flex items-center justify-between mb-3">
          <div class="p-2.5 bg-tpv-accent/10 text-tpv-accent rounded-2xl">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 11-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
          </div>
        </div>
        <p class="text-tpv-text-muted text-[10px] font-black uppercase tracking-widest">Pedidos hoy</p>
        <p class="text-3xl font-black text-tpv-text mt-1 font-mono" id="stat-orders">—</p>
      </div>

      <div class="bg-tpv-surface border border-tpv-border p-5 rounded-3xl">
        <div class="flex items-center justify-between mb-3">
          <div class="p-2.5 bg-orange-500/10 text-orange-500 rounded-2xl">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
          </div>
        </div>
        <p class="text-tpv-text-muted text-[10px] font-black uppercase tracking-widest">Productos</p>
        <p class="text-3xl font-black text-tpv-text mt-1 font-mono" id="stat-products">—</p>
      </div>

      <div class="bg-tpv-surface border border-tpv-border p-5 rounded-3xl">
        <div class="flex items-center justify-between mb-3">
          <div class="p-2.5 bg-purple-500/10 text-purple-500 rounded-2xl">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          </div>
        </div>
        <p class="text-tpv-text-muted text-[10px] font-black uppercase tracking-widest">Empleados</p>
        <p class="text-3xl font-black text-tpv-text mt-1 font-mono" id="stat-employees">—</p>
      </div>

    </div>

    <!-- Bottom row -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">

      <!-- Quick links (2/3) -->
      <div class="lg:col-span-2 bg-tpv-surface border border-tpv-border p-6 rounded-3xl">
        <h2 class="text-sm font-black text-tpv-text uppercase tracking-wider mb-5">Accesos Rápidos</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">

          <a href="/admin/productos"
            class="flex items-center gap-3 p-4 bg-tpv-bg rounded-2xl border border-tpv-border hover:border-tpv-accent hover:bg-tpv-accent/5 group transition-all">
            <div class="w-9 h-9 bg-orange-500/10 text-orange-500 rounded-xl flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
            </div>
            <span class="font-bold text-tpv-text text-sm">Productos</span>
          </a>

          <a href="/admin/categorias"
            class="flex items-center gap-3 p-4 bg-tpv-bg rounded-2xl border border-tpv-border hover:border-tpv-accent hover:bg-tpv-accent/5 group transition-all">
            <div class="w-9 h-9 bg-teal-500/10 text-teal-500 rounded-xl flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
            </div>
            <span class="font-bold text-tpv-text text-sm">Categorías</span>
          </a>

          <a href="/admin/mesas"
            class="flex items-center gap-3 p-4 bg-tpv-bg rounded-2xl border border-tpv-border hover:border-tpv-accent hover:bg-tpv-accent/5 group transition-all">
            <div class="w-9 h-9 bg-tpv-accent/10 text-tpv-accent rounded-xl flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
            </div>
            <span class="font-bold text-tpv-text text-sm">Mesas</span>
          </a>

          <a href="/admin/empleados"
            class="flex items-center gap-3 p-4 bg-tpv-bg rounded-2xl border border-tpv-border hover:border-tpv-accent hover:bg-tpv-accent/5 group transition-all">
            <div class="w-9 h-9 bg-purple-500/10 text-purple-500 rounded-xl flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <span class="font-bold text-tpv-text text-sm">Personal</span>
          </a>

          <a href="/admin/ventas"
            class="flex items-center gap-3 p-4 bg-tpv-bg rounded-2xl border border-tpv-border hover:border-tpv-accent hover:bg-tpv-accent/5 group transition-all">
            <div class="w-9 h-9 bg-green-500/10 text-green-500 rounded-xl flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
            </div>
            <span class="font-bold text-tpv-text text-sm">Ventas</span>
          </a>

          <button id="logout-btn"
            class="flex items-center gap-3 p-4 bg-tpv-bg rounded-2xl border border-tpv-border hover:border-red-500/50 hover:bg-red-500/5 group transition-all">
            <div class="w-9 h-9 bg-red-500/10 text-red-400 rounded-xl flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
            </div>
            <span class="font-bold text-red-400 text-sm">Cerrar sesión</span>
          </button>

        </div>
      </div>

      <!-- Live table status (1/3) -->
      <div class="bg-tpv-surface border border-tpv-border p-6 rounded-3xl flex flex-col">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-sm font-black text-tpv-text uppercase tracking-wider">Sala ahora</h2>
          <span id="occupancy-label" class="text-xs font-bold text-tpv-text-muted font-mono"></span>
        </div>
        <div id="mini-table-grid" class="grid grid-cols-4 gap-2 content-start flex-1"></div>
        <div class="flex items-center justify-between mt-4">
          <button id="tables-prev" class="p-1.5 rounded-lg border border-tpv-border text-tpv-text-muted hover:text-tpv-accent hover:border-tpv-accent transition-all disabled:opacity-30 disabled:cursor-not-allowed" aria-label="Anterior">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path d="M15 19l-7-7 7-7"/></svg>
          </button>
          <div class="flex items-center gap-2">
            <span id="tables-page-dots" class="flex gap-1"></span>
            <a href="/admin/mesas" class="text-xs font-black text-tpv-accent hover:underline uppercase tracking-wider ml-1">
              Ver todas →
            </a>
          </div>
          <button id="tables-next" class="p-1.5 rounded-lg border border-tpv-border text-tpv-text-muted hover:text-tpv-accent hover:border-tpv-accent transition-all disabled:opacity-30 disabled:cursor-not-allowed" aria-label="Siguiente">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>

    </div>
  </div>
</AdminLayout>

<script>
  const backendUrl = import.meta.env.PUBLIC_BACKEND_URL || 'http://127.0.0.1:8000';
  const token = () => localStorage.getItem('auth_token');

  // Greeting with name from token payload
  try {
    const payload = JSON.parse(atob(token()!.split('.')[1]));
    const name = payload.name || payload.email?.split('@')[0] || 'Administrador';
    document.getElementById('greeting')!.textContent = `Hola, ${name} 👋`;
  } catch {}

  async function loadDashboard() {
    try {
      const [resProducts, resUsers, resStats, resTables] = await Promise.all([
        fetch('/api/products'),
        fetch('/api/users', { headers: { Authorization: `Bearer ${token()}`, Accept: 'application/json' } }),
        fetch(`${backendUrl}/api/dashboard/stats`, { headers: { Authorization: `Bearer ${token()}`, Accept: 'application/json' } }),
        fetch(`${backendUrl}/api/tables`, { headers: { Authorization: `Bearer ${token()}`, Accept: 'application/json' } }),
      ]);

      const products = await resProducts.json();
      document.getElementById('stat-products')!.textContent = products.length;

      const users = await resUsers.json();
      document.getElementById('stat-employees')!.textContent = users.length;

      const stats = await resStats.json();
      document.getElementById('stat-sales')!.textContent   = stats.revenue_today.toFixed(2) + '€';
      document.getElementById('stat-orders')!.textContent  = String(stats.orders_today);

      const tables: any[] = await resTables.json();
      renderMiniTableGrid(tables);
    } catch {
      document.getElementById('stat-sales')!.textContent = 'Error';
    }
  }

  const TABLES_PER_PAGE = 12; // 4 cols × 3 rows
  let allTables: any[] = [];
  let currentPage = 0;

  function renderMiniTableGrid(tables: any[]) {
    allTables = tables;
    const occupied = tables.filter(t => t.status === 'occupied').length;
    const pending  = tables.filter(t => t.status === 'pending').length;
    document.getElementById('occupancy-label')!.textContent =
      `${occupied + pending}/${tables.length} ocupadas`;
    renderPage(currentPage);
  }

  function renderPage(page: number) {
    const grid  = document.getElementById('mini-table-grid')!;
    const dots  = document.getElementById('tables-page-dots')!;
    const prev  = document.getElementById('tables-prev') as HTMLButtonElement;
    const next  = document.getElementById('tables-next') as HTMLButtonElement;
    const total = Math.ceil(allTables.length / TABLES_PER_PAGE);

    currentPage = Math.max(0, Math.min(page, total - 1));

    const colorMap: Record<string, string> = {
      free:     'bg-tpv-bg border-tpv-border text-tpv-text-muted',
      occupied: 'bg-red-500/15 border-red-500/40 text-red-400',
      pending:  'bg-yellow-500/15 border-yellow-500/40 text-yellow-500',
    };

    const slice = allTables.slice(currentPage * TABLES_PER_PAGE, (currentPage + 1) * TABLES_PER_PAGE);
    grid.innerHTML = slice.map(t => `
      <div class="aspect-square rounded-xl border ${colorMap[t.status] || colorMap.free} flex flex-col items-center justify-center gap-0.5" title="Mesa ${t.number} — ${t.status}">
        <span class="text-sm font-black font-mono leading-none">${t.number}</span>
        ${t.call_waiter ? '<span class="text-[8px]">🔔</span>' : ''}
      </div>
    `).join('');

    dots.innerHTML = Array.from({ length: total }, (_, i) =>
      `<span class="w-1.5 h-1.5 rounded-full transition-all ${i === currentPage ? 'bg-tpv-accent scale-110' : 'bg-tpv-border'}"></span>`
    ).join('');

    prev.disabled = currentPage === 0;
    next.disabled = currentPage >= total - 1;
  }

  document.getElementById('tables-prev')?.addEventListener('click', () => renderPage(currentPage - 1));
  document.getElementById('tables-next')?.addEventListener('click', () => renderPage(currentPage + 1));

  document.getElementById('logout-btn')?.addEventListener('click', () => {
    localStorage.clear();
    document.cookie = 'auth_token=; path=/; Max-Age=0';
    document.cookie = 'user_role=; path=/; Max-Age=0';
    window.location.href = '/';
  });

  loadDashboard();
  setInterval(loadDashboard, 30000);
</script>
