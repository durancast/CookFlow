---
import Layout from '../../layouts/Layout.astro';
import DishCard from '../../components/DishCard.astro';
import NavSidebar from '../../components/NavSidebar.astro';
import OrderSidebar from '../../components/react/OrderSidebar.jsx'; 
import type { Product } from '../../types/api'; 

// El fetch del servidor (SSR) sigue usando la URL completa de Laravel
const backendUrl = import.meta.env.PUBLIC_BACKEND_URL || 'http://127.0.0.1:8000';

const res = await fetch(`${backendUrl}/api/products`);
const allProducts: Product[] = await res.json();
const products = allProducts.filter(p => p.available !== false);

const categories = ['Todos', ...new Set(products.map(p => p.category.name))];
---

<Layout title="TPV - CookFlow">
  <div class="flex h-screen overflow-hidden bg-tpv-bg relative font-sans">
    
    <aside class="hidden md:flex shrink-0 h-full border-r border-tpv-border bg-tpv-surface">
      <NavSidebar />
    </aside>

    <main class="flex-1 flex flex-col min-w-0 h-full overflow-hidden w-full relative">
      
      <header class="shrink-0 p-4 md:p-6 border-b border-tpv-border bg-tpv-surface/80 backdrop-blur-md flex justify-between items-center gap-4">
        <div class="flex gap-3 overflow-x-auto pb-2 custom-scrollbar flex-1">
          {categories.map((cat) => (
            <button
              class={`category-btn px-6 py-2.5 rounded-xl border transition-all whitespace-nowrap font-bold text-sm
                ${cat === 'Todos'
                  ? 'bg-tpv-accent border-tpv-accent text-white shadow-lg shadow-tpv-accent/20'
                  : 'bg-tpv-bg border-tpv-border text-tpv-text-muted hover:border-tpv-accent hover:text-tpv-accent'}`}
            >
              {cat}
            </button>
          ))}
        </div>

        <div class="relative shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-tpv-text-muted pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            id="tpv-search"
            type="text"
            placeholder="Buscar plato..."
            class="pl-9 pr-4 py-2.5 w-40 xl:w-56 bg-tpv-bg border border-tpv-border rounded-xl text-sm text-tpv-text placeholder:text-tpv-text-muted/50 focus:outline-none focus:border-tpv-accent transition-colors"
          />
        </div>

        <button
          id="tpv-logout-btn"
          class="shrink-0 p-3 rounded-xl bg-tpv-bg border border-tpv-border text-tpv-text-muted hover:text-red-400 hover:border-red-400/30 transition-all active:scale-90"
          title="Cerrar Sesión"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
        </button>
      </header>

      <section class="flex-1 overflow-y-auto p-4 md:p-6 custom-scrollbar relative bg-tpv-bg">
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 gap-4 pb-32 lg:pb-10">
          {products.map(p => <DishCard product={p} />)}
        </div>
      </section>

      <div class="absolute bottom-0 left-0 w-full p-6 bg-linear-to-t from-tpv-bg via-tpv-bg/95 to-transparent lg:hidden z-50">
        <button id="mobile-cart-btn" class="w-full bg-tpv-accent hover:bg-tpv-accent-hover text-white font-black py-4 px-6 rounded-2xl shadow-2xl flex justify-between items-center transition-all border border-white/10">
          <div class="flex items-center gap-3">
            <span id="mobile-cart-count" class="bg-white/20 text-white text-sm py-1.5 px-3 rounded-lg font-mono font-bold">0</span>
            <span class="tracking-widest uppercase text-sm">Ver Pedido</span>
          </div>
          <span id="mobile-cart-total" class="font-mono text-xl font-black">0.00€</span>
        </button>
      </div>
    </main>

    <aside class="hidden lg:flex shrink-0 w-80 xl:w-96 border-l border-tpv-border h-full bg-tpv-bg z-40">
      <OrderSidebar client:only="react" />
    </aside>
  </div>

  <div id="notes-modal" class="hidden fixed inset-0 z-[200] flex items-center justify-center p-4 bg-tpv-bg/90 backdrop-blur-md">
    <div class="bg-tpv-surface w-full max-w-sm rounded-3xl shadow-2xl p-8 border border-tpv-border animate-in fade-in zoom-in-95 duration-150">
      <h3 id="notes-modal-title" class="text-xl font-black text-tpv-text mb-2"></h3>
      <p class="text-[11px] uppercase tracking-widest text-tpv-text-muted font-bold mb-5">Añadir nota (opcional)</p>
      <input
        id="notes-modal-input"
        type="text"
        placeholder="Sin cebolla, punto medio, alérgico a..."
        class="w-full p-4 bg-tpv-bg text-tpv-text border border-tpv-border rounded-xl focus:outline-none focus:border-tpv-accent transition-colors mb-6 placeholder:text-tpv-text-muted/40 text-sm"
      />
      <div class="flex gap-3">
        <button id="notes-modal-cancel" class="flex-1 py-3 bg-tpv-bg text-tpv-text-muted border border-tpv-border rounded-xl font-black uppercase text-sm transition-all active:scale-95 hover:text-tpv-text">Cancelar</button>
        <button id="notes-modal-confirm" class="flex-[2] py-3 bg-tpv-accent hover:bg-tpv-accent-hover text-white rounded-xl font-black uppercase text-sm shadow-lg shadow-tpv-accent/20 transition-all active:scale-95">Añadir</button>
      </div>
    </div>
  </div>

  <div id="select-table-modal" class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-tpv-bg/90 backdrop-blur-md transition-opacity">
    <div class="bg-tpv-surface w-full max-w-4xl rounded-3xl shadow-2xl p-8 border border-tpv-border animate-in fade-in zoom-in-95 duration-200">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-black text-tpv-text mb-2">Gestión de Sala</h2>
        <p class="text-tpv-text-muted font-bold uppercase tracking-widest text-sm">Selecciona una mesa para comenzar el servicio</p>
      </div>
      <div id="modal-tables-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        <div class="col-span-full text-center p-10 animate-pulse text-tpv-accent font-bold uppercase">Cargando mapa de sala...</div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { cartItems, selectedTable, addToCart } from '../../store/cartStore.js';

  // Middleware handles server-side auth; localStorage token still used for API calls

  async function loadTableSelection() {
    const container = document.getElementById('modal-tables-grid');
    if (!container) return;
    try {
      const response = await fetch("/api/tables", {
        headers: {
          'Authorization': `Bearer ${localStorage.getItem('auth_token')}`,
          'Accept': 'application/json'
        }
      });
      if (response.status === 401) { window.location.href = '/'; return; }
      const tables = await response.json();
      container.innerHTML = tables.map((table: any) => {
        let bgClass = 'bg-tpv-bg border-tpv-border text-tpv-text hover:border-tpv-accent';
        let textStatus = 'Libre';
        let dotPulse = '';
        if (table.status === 'occupied') {
          bgClass = 'bg-red-500/5 border-red-500/30 text-red-400';
          textStatus = 'En Servicio';
          dotPulse = '<div class="absolute top-4 right-4 w-3 h-3 bg-red-500 rounded-full animate-pulse"></div>';
        } else if (table.status === 'pending') {
          bgClass = 'bg-yellow-500/10 border-yellow-500/40 text-yellow-500';
          textStatus = 'Cobrando';
          dotPulse = '<div class="absolute top-4 right-4 w-3 h-3 bg-yellow-500 rounded-full animate-pulse"></div>';
        }
        return `
          <button data-table-id="${table.id}" onclick="window.selectTable(${table.id}, ${table.number}, '${table.status}')"
            class="relative flex flex-col items-center justify-center p-10 rounded-[2.5rem] border-2 transition-all active:scale-95 cursor-pointer ${bgClass}">
            <span class="text-5xl font-black mb-2 font-mono">${table.number}</span>
            <span class="text-[10px] uppercase font-black tracking-widest opacity-60">${textStatus}</span>
            ${dotPulse}
          </button>`;
      }).join('');
    } catch (error) {
      container.innerHTML = `<p class="col-span-full text-center text-red-500 font-bold">Error al cargar sala.</p>`;
    }
  }

  // 👇 VIGILANTE DE MESA. Si es null, muestra modal Y refresca mesas
  selectedTable.subscribe(table => {
    if (!table) {
      const modal = document.getElementById('select-table-modal');
      if (modal) {
        modal.classList.remove('hidden');
        loadTableSelection();
      }
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    
    // --- 🚪 LÓGICA DE LOGOUT ---
    document.getElementById('tpv-logout-btn')?.addEventListener('click', () => {
      localStorage.clear();
      document.cookie = 'auth_token=; path=/; Max-Age=0';
      document.cookie = 'user_role=; path=/; Max-Age=0';
      window.location.href = '/';
    });

    // --- LÓGICA DEL CARRITO ---
    const countEl = document.getElementById('mobile-cart-count');
    const totalEl = document.getElementById('mobile-cart-total');

    cartItems.subscribe((items: readonly any[]) => {
      const totalItems = items.reduce((sum, item) => sum + item.quantity, 0);
      const totalPrice = items.reduce((sum, item) => sum + (item.price * item.quantity), 0);
      if (countEl) countEl.textContent = totalItems.toString();
      if (totalEl) totalEl.textContent = totalPrice.toFixed(2) + '€';

      if (totalItems > 0) {
        const table = selectedTable.get();
        if (table && table.status === 'free') {
          fetch(`/api/tables/${table.id}/status`, {
            method: 'PATCH',
            headers: {
              'Authorization': `Bearer ${localStorage.getItem('auth_token')}`,
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ status: 'occupied' })
          });
          selectedTable.set({ ...table, status: 'occupied' });
        }
      }
    });

    // --- LÓGICA DE FILTRADO ---
    const categoryButtons = document.querySelectorAll('.category-btn');
    const dishCards = document.querySelectorAll('.dish-card');
    let activeCategory = 'all';
    let searchTerm = '';

    function applyFilters() {
      dishCards.forEach(card => {
        const cardCategory = (card.getAttribute('data-category') || '').trim().toLowerCase();
        const cardName = (card.querySelector('h3')?.textContent || '').trim().toLowerCase();
        const matchesCategory = activeCategory === 'all' || cardCategory === activeCategory;
        const matchesSearch = !searchTerm || cardName.includes(searchTerm);
        if (matchesCategory && matchesSearch) {
          card.classList.remove('hidden'); card.classList.add('flex');
        } else {
          card.classList.add('hidden'); card.classList.remove('flex');
        }
      });
    }

    categoryButtons.forEach(button => {
      button.addEventListener('click', () => {
        const buttonText = button.textContent?.trim().toLowerCase();
        activeCategory = buttonText === 'todos' ? 'all' : (buttonText || 'all');
        applyFilters();

        categoryButtons.forEach(btn => {
          btn.classList.remove('bg-tpv-accent', 'text-white', 'border-tpv-accent', 'shadow-lg');
          btn.classList.add('bg-tpv-bg', 'text-tpv-text-muted', 'border-tpv-border');
        });
        button.classList.add('bg-tpv-accent', 'text-white', 'border-tpv-accent', 'shadow-lg');
      });
    });

    document.getElementById('tpv-search')?.addEventListener('input', (e) => {
      searchTerm = (e.target as HTMLInputElement).value.trim().toLowerCase();
      applyFilters();
    });

    // --- NOTAS MODAL ---
    let pendingProduct: any = null;

    document.addEventListener('dish-add', (e: Event) => {
      pendingProduct = (e as CustomEvent).detail;
      const modal = document.getElementById('notes-modal');
      const title = document.getElementById('notes-modal-title');
      const input = document.getElementById('notes-modal-input') as HTMLInputElement;
      if (modal && title && input) {
        title.textContent = pendingProduct.name;
        input.value = '';
        modal.classList.remove('hidden');
        setTimeout(() => input.focus(), 50);
      }
    });

    function closeNotesModal() {
      pendingProduct = null;
      document.getElementById('notes-modal')?.classList.add('hidden');
    }

    function confirmNotesModal() {
      if (!pendingProduct) return;
      const input = document.getElementById('notes-modal-input') as HTMLInputElement;
      addToCart(pendingProduct, input?.value?.trim() || '');
      closeNotesModal();
    }

    document.getElementById('notes-modal-confirm')?.addEventListener('click', confirmNotesModal);
    document.getElementById('notes-modal-cancel')?.addEventListener('click', closeNotesModal);
    document.getElementById('notes-modal-input')?.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter') confirmNotesModal();
      else if (e.key === 'Escape') closeNotesModal();
    });

    // 🔥 FUNCIÓN GLOBAL ACTUALIZADA (Soporta Entrar a Mesas Ocupadas o Pendientes)
    (window as any).selectTable = async (id: number, number: number, currentStatus: string) => {
      // Save unsent items for whichever table we're leaving
      const prevTable = selectedTable.get();
      if (prevTable) {
        const unsent = cartItems.get().filter((i: any) => !i.sent);
        if (unsent.length > 0) {
          localStorage.setItem(`draft_table_${prevTable.id}`, JSON.stringify(unsent));
        }
      }

      const btn = document.querySelector(`[data-table-id="${id}"]`) as HTMLButtonElement | null;
      const draft: any[] = JSON.parse(localStorage.getItem(`draft_table_${id}`) || '[]');
      try {
        let resolvedStatus = currentStatus;

        if (currentStatus === 'occupied' || currentStatus === 'pending') {
          if (btn) {
            btn.disabled = true;
            btn.innerHTML = `<span class="text-2xl font-mono animate-pulse">···</span><span class="text-[10px] uppercase font-black tracking-widest opacity-60 mt-2">Cargando</span>`;
          }
          const res = await fetch(`/api/tables/${id}/active-order`, {
            headers: { 'Authorization': `Bearer ${localStorage.getItem('auth_token')}` }
          });

          if (res.ok) {
            const data = await res.json();
            const backendItems = (data.items || []).map((i: any) => ({ ...i, sent: true }));
            cartItems.set([...backendItems, ...draft]);
            fetch(`/api/tables/${id}/clear-waiter`, {
              method: 'POST',
              headers: { 'Authorization': `Bearer ${localStorage.getItem('auth_token')}` }
            });
          }
        } else {
          cartItems.set(draft);
          resolvedStatus = 'free';
        }

        // 3. Seteamos la mesa en el store (con status para OrderSidebar)
        selectedTable.set({ id, number, status: resolvedStatus });

        // 4. Cerramos el modal con animación
        const modal = document.getElementById('select-table-modal');
        if (modal) {
          modal.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
          setTimeout(() => {
            modal.classList.add('hidden');
            // Reset de clases para la próxima apertura
            modal.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
          }, 200);
        }
      } catch (e) {
        if (window.showToast) window.showToast('Error al comunicar con el servidor', 'error');
      }
    };

    // Refresco automático cada 30 seg para ver mesas ocupadas por otros
    setInterval(loadTableSelection, 30000);
    loadTableSelection();
  });
</script>